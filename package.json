{
  "name": "usehlsvideoplayer",
  "version": "2.0.1",
  "description": "Headless HLS playback controller and React hooks",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.playground.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "playwright test",
    "test:browser:chromium": "playwright test --project=chromium",
    "test:browser:native": "playwright test --project=native",
    "check:package": "node scripts/check-package.mjs",
    "dev": "vite --host 127.0.0.1",
    "fixtures": "node scripts/fixtures.mjs",
    "audit": "npm audit --audit-level=moderate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klevert-ope/Usehlsvideoplayer.git"
  },
  "keywords": [
    "hls",
    "video",
    "m3u8"
  ],
  "author": "Klevert Opee",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/klevert-ope/Usehlsvideoplayer/issues"
  },
  "homepage": "https://github.com/klevert-ope/Usehlsvideoplayer#readme",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/esm/core.d.ts",
        "default": "./dist/esm/core.js"
      },
      "require": {
        "types": "./dist/cjs/core.d.ts",
        "default": "./dist/cjs/core.js"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "hls.js": "~1.7.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
